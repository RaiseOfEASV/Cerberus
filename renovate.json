{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "commitMessagePrefix": "chore(deps):",
  "packageRules": [
    {
      "description": "Auto-merge patch/minor once CI is green; majors always need a human",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "platformAutomerge": true
    },
    {
      "description": "Majors always require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Group Go module updates",
      "matchManagers": ["gomod"],
      "groupName": "go dependencies"
    },
    {
      "description": "Group npm/JS updates",
      "matchManagers": ["npm"],
      "groupName": "js dependencies"
    },
    {
      "description": "Pin GitHub Actions by SHA, not tag - tags are mutable",
      "matchManagers": ["github-actions"],
      "pinDigests": true
    },
    {
      "description": "Pin Docker base images by digest",
      "matchManagers": ["dockerfile"],
      "pinDigests": true
    },
    {
      "description": "Group Helm chart and Terraform provider/module bumps separately from app deps",
      "matchManagers": ["helm-values", "helmv3", "terraform"],
      "groupName": "infra dependencies"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  }
}
