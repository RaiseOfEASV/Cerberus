# Minimal, hand-written starting ruleset covering identity files, sudo
# scope, SSH config, and exec tracking - NOT a transcription of the CIS
# benchmark's own rule text (that's copyrighted CIS content, not something
# to vendor verbatim into this repo). Expand against the actual CIS
# Debian/Ubuntu Linux Benchmark PDF as a follow-up if/when full CIS audit
# coverage is actually needed - this is a reasonable baseline, not a claim
# of full compliance.

-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k scope
-w /etc/sudoers.d/ -p wa -k scope
-w /etc/ssh/sshd_config -p wa -k sshd
# Commands run by people who logged in (SSH, sudo). auid is the login user
# and survives sudo; container processes have no login user, so this keeps
# the volume manageable on a Kubernetes node (Falco covers containers).
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=unset -k exec
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=unset -k exec
# Privilege use and changes to how the host or the cluster is configured.
-w /usr/bin/sudo -p x -k priv
-w /etc/ssh/sshd_config.d/ -p wa -k sshd
-w /root/.ssh/ -p wa -k sshkeys
-w /etc/cron.d/ -p wa -k cron
-w /etc/systemd/system/ -p wa -k systemd
-w /etc/rancher/ -p wa -k k3s
-w /etc/netplan/ -p wa -k network
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules
-e 2
